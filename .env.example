# MongoDB Atlas. The app role should have readWrite only on this database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=kaspa_transportations

# Kaspa starts on testnet-10. A direct wRPC URL is optional; the official
# resolver is used when this is empty.
KASPA_NETWORK=testnet-10
KASPA_RPC_URL=
KASPA_RESOLVER_PUBLIC_KEY=
KASPA_COVENANT_COMPUTE_BUDGET=3000
KASPA_PRIORITY_FEE_SOMPI=0

# Mainnet is deliberately fail-closed until a contract audit is completed.
ENABLE_MAINNET_COVENANTS=

# Long random values. Generate each with: openssl rand -hex 32
SESSION_SECRET=
INTERNAL_RECONCILER_SECRET=

# Public application origin, without a trailing slash.
APP_ORIGIN=http://localhost:3000

# Next.js development-only proxy target for the separately running FastAPI process.
LOCAL_API_ORIGIN=http://127.0.0.1:8000
